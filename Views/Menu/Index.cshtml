@using Quanan.Models
@{
    ViewData["Title"] = "Quản lý Thực Đơn (Menu)";
    var categories = ViewData["Categories"] as List<Category>;
    var menuItems = ViewData["MenuItems"] as List<MenuItem>;
    var selectedCategoryId = (int)ViewData["SelectedCategoryId"];
}

<div class="glass-panel">
    <div class="panel-header">
        <span class="panel-title"><i class="fa-solid fa-utensils text-success"></i> Danh mục thực đơn & Món ăn</span>
        <div style="display: flex; gap: 8px;">
            <button class="btn-outline" onclick="openNewCategoryModal()">
                <i class="fa-solid fa-folder-plus"></i> Thêm danh mục
            </button>
            <button class="btn-accent" onclick="openNewItemModal()">
                <i class="fa-solid fa-plus"></i> Thêm món mới
            </button>
        </div>
    </div>

    <!-- Category Filter pills -->
    <div class="area-tabs" style="margin-bottom: 24px;">
        <a href="/Menu/Index" class="area-tab @(selectedCategoryId == 0 ? "active" : "")" style="text-decoration: none;">Tất cả món</a>
        @foreach (var cat in categories)
        {
            <a href="/Menu/Index?categoryId=@cat.Id" class="area-tab @(selectedCategoryId == cat.Id ? "active" : "")" style="text-decoration: none;">@cat.Name</a>
        }
    </div>

    <!-- Menu items table -->
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã món</th>
                    <th>Tên món</th>
                    <th style="text-align: right;">Giá bán</th>
                    <th style="text-align: right;">Giá vốn</th>
                    <th style="text-align: center;">Thuế VAT</th>
                    <th>Mã Barcode</th>
                    <th style="text-align: center;">Trạng thái kinh doanh</th>
                    <th style="text-align: center;">Tùy chọn</th>
                </tr>
            </thead>
            <tbody>
                @if (menuItems != null && menuItems.Count > 0)
                {
                    foreach (var item in menuItems)
                    {
                        var btnColor = item.IsActive ? "bg-success" : "bg-secondary";
                        var statusText = item.IsActive ? "Đang bán" : "Ngừng bán";
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td style="display: flex; align-items: center; gap: 10px;">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <div style="width: 40px; height: 40px; border-radius: 6px; background-image: url('@item.ImageUrl'); background-size: cover; background-position: center; border: 1px solid var(--border-color); flex-shrink: 0;"></div>
                                }
                                else
                                {
                                    <div style="width: 40px; height: 40px; border-radius: 6px; background: var(--bg-tertiary); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color); color: var(--text-muted); flex-shrink: 0;"><i class="fa-solid fa-bowl-food" style="font-size: 16px;"></i></div>
                                }
                                <div>
                                    <div><strong>@item.Name</strong></div>
                                    <span style="font-size: 11px; color: var(--text-muted);">@item.Category?.Name</span>
                                </div>
                            </td>
                            <td style="text-align: right; font-weight: 600;" class="text-success">@item.Price.ToString("N0")đ</td>
                            <td style="text-align: right; color: var(--text-muted);">@item.CostPrice.ToString("N0")đ</td>
                            <td style="text-align: center;">@item.VatPercent.ToString("F0")%</td>
                            <td><span style="font-family: monospace;">@(item.Barcode ?? "N/A")</span></td>
                            <td style="text-align: center;">
                                <form asp-action="ToggleStatus" method="post" style="display: inline;">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="badge @btnColor text-white border-0 px-2 py-1 rounded" style="cursor: pointer;">
                                        @statusText
                                    </button>
                                </form>
                            </td>
                            <td style="text-align: center;">
                                <button type="button" onclick="openEditItemModal(@item.Id, '@item.Code', '@item.Name', @item.Price, @item.CostPrice, @item.VatPercent, '@(item.Barcode ?? "")', @item.CategoryId, '@(item.ImageUrl ?? "")', '@(item.VideoUrl ?? "")')" class="btn-outline" style="padding: 4px 8px; font-size: 12px; border-color: var(--accent-color); color: var(--accent-color); margin-right: 4px; display: inline-flex; align-items: center; gap: 4px;">
                                    <i class="fa-regular fa-pen-to-square"></i> Sửa
                                </button>
                                <form asp-action="DeleteMenuItem" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa món ăn này khỏi menu?')">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="btn-outline" style="padding: 4px 8px; font-size: 12px; border-color: var(--status-locked); color: var(--status-locked);">
                                        <i class="fa-regular fa-trash-can"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted" style="padding: 40px 0;">Chưa có món ăn nào trong danh mục này.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: New Category -->
<div id="newCategoryModal" class="modal-overlay" onclick="closeNewCategoryModal(event)">
    <div class="modal-content-panel" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="panel-title"><i class="fa-solid fa-folder-plus text-success"></i> Thêm Danh Mục Thực Đơn</span>
            <span class="modal-close" onclick="closeNewCategoryModal(null)">&times;</span>
        </div>
        <form asp-action="CreateCategory" method="post">
            <div class="form-group">
                <label>Tên danh mục thực đơn *</label>
                <input type="text" name="name" class="form-control" placeholder="Đồ ăn vặt, Tráng miệng..." required />
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-outline" onclick="closeNewCategoryModal(null)">Hủy</button>
                <button type="submit" class="btn-accent">Lưu danh mục</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: New Menu Item -->
<div id="newItemModal" class="modal-overlay" onclick="closeNewItemModal(event)">
    <div class="modal-content-panel" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="panel-title"><i class="fa-solid fa-plus text-success"></i> Thêm món ăn / đồ uống mới</span>
            <span class="modal-close" onclick="closeNewItemModal(null)">&times;</span>
        </div>
        <form asp-action="CreateMenuItem" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label>Tên món ăn / đồ uống *</label>
                <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Phở gà, Trà tắc..." required />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Mã món (Code) *</label>
                    <input type="text" name="Code" class="form-control" placeholder="Ví dụ: F010" required />
                </div>
                <div class="form-group">
                    <label>Mã vạch (Barcode)</label>
                    <input type="text" name="Barcode" class="form-control" placeholder="893..." />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Giá bán (VNĐ) *</label>
                    <input type="number" name="Price" class="form-control" placeholder="0" required />
                </div>
                <div class="form-group">
                    <label>Giá vốn (VNĐ) *</label>
                    <input type="number" name="CostPrice" class="form-control" placeholder="0" required />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Chọn nhóm danh mục *</label>
                    <select name="CategoryId" class="form-control" required>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Thuế VAT (%)</label>
                    <input type="number" step="0.1" name="VatPercent" class="form-control" value="8" />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Chọn hình ảnh từ máy</label>
                    <input type="file" name="imageFile" class="form-control" style="background: transparent;" accept="image/*" />
                </div>
                <div class="form-group">
                    <label>Hoặc dán URL hình ảnh</label>
                    <input type="text" name="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Chọn video từ máy</label>
                    <input type="file" name="videoFile" class="form-control" style="background: transparent;" accept="video/*" />
                </div>
                <div class="form-group">
                    <label>Hoặc dán URL video (Youtube/Web)</label>
                    <input type="text" name="VideoUrl" class="form-control" placeholder="https://youtube.com/embed/..." />
                </div>
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-outline" onclick="closeNewItemModal(null)">Hủy</button>
                <button type="submit" class="btn-accent">Thêm món ăn</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Edit Menu Item -->
<div id="editItemModal" class="modal-overlay" onclick="closeEditItemModal(event)">
    <div class="modal-content-panel" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="panel-title"><i class="fa-solid fa-pen-to-square text-success"></i> Sửa Món Ăn</span>
            <span class="modal-close" onclick="closeEditItemModal(null)">&times;</span>
        </div>
        <form asp-action="UpdateMenuItem" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Id" id="editItemId" />
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Mã món</label>
                    <input type="text" name="Code" id="editItemCode" class="form-control" required readonly />
                </div>
                <div class="form-group">
                    <label>Tên món ăn *</label>
                    <input type="text" name="Name" id="editItemName" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <label>Danh mục *</label>
                <select name="CategoryId" id="editItemCategoryId" class="form-control" required>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Giá bán (đ) *</label>
                    <input type="number" name="Price" id="editItemPrice" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Giá vốn (đ) *</label>
                    <input type="number" name="CostPrice" id="editItemCostPrice" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Thuế VAT (%)</label>
                    <input type="number" name="VatPercent" id="editItemVat" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <label>Mã Barcode</label>
                <input type="text" name="Barcode" id="editItemBarcode" class="form-control" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Chọn hình ảnh thay thế</label>
                    <input type="file" name="editImageFile" class="form-control" style="background: transparent;" accept="image/*" />
                </div>
                <div class="form-group">
                    <label>Hoặc dán URL hình ảnh</label>
                    <input type="text" name="ImageUrl" id="editItemImageUrl" class="form-control" />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label>Chọn video thay thế</label>
                    <input type="file" name="editVideoFile" class="form-control" style="background: transparent;" accept="video/*" />
                </div>
                <div class="form-group">
                    <label>Hoặc dán URL video (Youtube/Web)</label>
                    <input type="text" name="VideoUrl" id="editItemVideoUrl" class="form-control" />
                </div>
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-outline" onclick="closeEditItemModal(null)">Hủy</button>
                <button type="submit" class="btn-accent">Cập nhật món</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openNewCategoryModal() {
            document.getElementById('newCategoryModal').style.display = 'flex';
        }
        function closeNewCategoryModal(e) {
            if (e === null || e.target === document.getElementById('newCategoryModal')) {
                document.getElementById('newCategoryModal').style.display = 'none';
            }
        }

        function openNewItemModal() {
            document.getElementById('newItemModal').style.display = 'flex';
        }
        function closeNewItemModal(e) {
            if (e === null || e.target === document.getElementById('newItemModal')) {
                document.getElementById('newItemModal').style.display = 'none';
            }
        }

        function openEditItemModal(id, code, name, price, costPrice, vat, barcode, catId, imageUrl, videoUrl) {
            document.getElementById('editItemId').value = id;
            document.getElementById('editItemCode').value = code;
            document.getElementById('editItemName').value = name;
            document.getElementById('editItemPrice').value = price;
            document.getElementById('editItemCostPrice').value = costPrice;
            document.getElementById('editItemVat').value = vat;
            document.getElementById('editItemBarcode').value = barcode;
            document.getElementById('editItemCategoryId').value = catId;
            document.getElementById('editItemImageUrl').value = imageUrl;
            document.getElementById('editItemVideoUrl').value = videoUrl;

            document.getElementById('editItemModal').style.display = 'flex';
        }
        function closeEditItemModal(e) {
            if (e === null || e.target === document.getElementById('editItemModal')) {
                document.getElementById('editItemModal').style.display = 'none';
            }
        }
    </script>
}
