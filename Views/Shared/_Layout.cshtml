        function changeLanguage(lang) {
            localStorage.setItem("selectedLanguage", lang);
            
            // Translate sidebar labels
            for (var key in translations[lang]) {
                var el = document.querySelector("#" + key + " span");
                if (el) {
                    el.innerText = translations[lang][key];
                }
            }

            // Translate role badge
            var roleBadge = document.querySelector(".user-role-badge");
            if (roleBadge) {
                roleBadge.innerHTML = '<i class="fa-solid fa-shield-halved"></i> ' + translations[lang]["role-admin"];
            }

            // Translate all elements with data-translate attribute
            var translateElems = document.querySelectorAll("[data-translate]");
            translateElems.forEach(function(el) {
                var key = el.getAttribute("data-translate");
                if (translations[lang] && translations[lang][key]) {
                    // Check if it's an input/textarea with a placeholder
                    if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") {
                        if (el.hasAttribute("placeholder")) {
                            el.setAttribute("placeholder", translations[lang][key]);
                        }
                    } else {
                        // Keep icons if they exist!
                        var icon = el.querySelector("i");
                        if (icon) {
                            el.innerHTML = "";
                            el.appendChild(icon);
                            el.appendChild(document.createTextNode(" " + translations[lang][key]));
                        } else {
                            el.innerText = translations[lang][key];
                        }
                    }
                }
            });

            // Dispatch event for other pages to listen
            var event = new CustomEvent("langChanged", { detail: lang });
            document.dispatchEvent(event);
        }

        // Apply on load
        document.addEventListener("DOMContentLoaded", function() {
            var savedLang = localStorage.getItem("selectedLanguage") || "vi";
            var langSel = document.getElementById("langSelect");
            if (langSel) {
                langSel.value = savedLang;
            }
            changeLanguage(savedLang);
        });
