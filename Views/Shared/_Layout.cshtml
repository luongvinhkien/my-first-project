                    <a class="sidebar-link" id="nav-crm" href="/Crm/Index">
                        <i class="fa-solid fa-users"></i>
                        <span>Khách hàng (CRM)</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link" id="nav-inventory" href="/Inventory/Index">
                        <i class="fa-solid fa-warehouse"></i>
                        <span>Công thức & Kho</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link" id="nav-procurement" href="/Procurement/Index">
